#include <dos.h>

#define PIT_FREQ 1193180L

void speaker_on(unsigned int freq)
{
    unsigned int div;
    unsigned char tmp;

    div = (unsigned int)(PIT_FREQ / freq);

    /* Configure PIT channel 2 */
    outp(0x43, 0xB6);
    outp(0x42, div & 0xFF);
    outp(0x42, div >> 8);

    /* Active le speaker */
    tmp = inp(0x61);
    outp(0x61, tmp | 3);
}

void speaker_off(void)
{
    unsigned char tmp = inp(0x61);
    outp(0x61, tmp & ~3);
}

void delay_ms(unsigned int ms)
{
    delay(ms); /* Turbo C / Watcom */
}

void shoot_beeper(void)
{
    int f;

    /* Attaque brutale */
    speaker_on(220);
    delay_ms(20);

    /* Chute rapide de fréquence */
    for (f = 220; f > 70; f -= 8)
    {
        speaker_on(f);
        delay_ms(4);
    }

    /* Queue grave */
    speaker_on(60);
    delay_ms(40);

    speaker_off();
}
